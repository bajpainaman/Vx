//===----------------------------------------------------------------------===//
// `lanes::sort_by(&mut t, n, less)` on the CPU copy of a kernel (`CUDA_VISIBLE_DEVICES=`). A
// block of 256 lanes sorts the first 500 of 512 keys up with `a < b`, and then all 512 down with
// `a > b`. Then it sorts the first 100 keys by their last digit, so many keys tie, and a sort by
// value is not in this order. Each of two subgroups of 32 lanes sorts the first 20 keys of its
// row of 64 down, with a function that calls another function. For each sort, the host checks the
// order, and compares the sum and the sum of squares of the sorted keys with those of the keys.
// The keys past the count must not change. The program also prints `lanes::sort_descending`, so
// its results stay those of `sort_by` with `a > b`.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: up in order true same keys true tail kept true first -499000 last 500000
// CHECK-NEXT: down in order true same keys true first 500000 last -499000
// CHECK-NEXT: digits in order true same keys true tail kept true first digit 0 last digit 9
// CHECK-NEXT: row 0 in order true same keys true tail kept true
// CHECK-NEXT: row 1 in order true same keys true tail kept true
// CHECK-NEXT: sort_descending gives the same keys true

fn less_than(a : i64, b : i64) -> bool {
  return a < b;
}

fn greater(a : i64, b : i64) -> bool {
  return a > b;
}

fn last_digit(a : i64) -> i64 {
  return a % 10;
}

fn by_last_digit(a : i64, b : i64) -> bool {
  return last_digit(a) < last_digit(b);
}

// Key `i` of 1000 values from -499000 to 500000, with repeats. The kernels compute it too.
fn key(i : i32) -> i64 {
  return (((i * 7919) % 1000) as i64 - 499) * 1000;
}

// Key `i` of 1000 values from 0 to 999, with repeats. The kernels compute it too.
fn digits_key(i : i32) -> i64 {
  return ((i * 7919) % 1000) as i64;
}

// Whether `t[from..from + n]` goes up (`mode` 0), goes down (1), or goes up by its last digit (2).
fn in_order(t : &Tensor<i64, [?]>, from : i32, n : i32, mode : i32) -> bool {
  let mut ok = true;
  for i in from + 1..from + n {
    if mode == 0 && t[i - 1] > t[i] {
      ok = false;
    }
    if mode == 1 && t[i - 1] < t[i] {
      ok = false;
    }
    if mode == 2 && t[i - 1] % 10 > t[i] % 10 {
      ok = false;
    }
  }
  return ok;
}

// Whether `t[from..from + n]` has the sum and the sum of squares of the keys `base` to
// `base + n - 1`: of `digits_key` with `digits`, and of `key` otherwise.
fn same_keys(t : &Tensor<i64, [?]>, from : i32, base : i32, n : i32, digits : bool) -> bool {
  let mut sum : i64 = 0;
  let mut squares : i64 = 0;
  for i in 0..n {
    let mut k = key(base + i);
    if digits {
      k = digits_key(base + i);
    }
    sum = sum + t[from + i] - k;
    squares = squares + t[from + i] * t[from + i] / 1000 - k * k / 1000;
  }
  return sum == 0 && squares == 0;
}

fn main() -> i32 {
  let mut up = transfer(Tensor<i64, [512]>::fill(0), Memory::HBM);
  let mut down = transfer(Tensor<i64, [512]>::fill(0), Memory::HBM);
  let mut by_digit = transfer(Tensor<i64, [512]>::fill(0), Memory::HBM);
  let mut old_down = transfer(Tensor<i64, [512]>::fill(0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut keys = unsafe { Tensor<i64, [512], Memory::SMEM>::uninit() };
      for t in 0..512 across lanes(256) {
        keys[t] = (((t * 7919) % 1000) as i64 - 499) * 1000;
      }
      lanes::sort_by(&mut keys, 500, less_than);
      for t in 0..512 across lanes(256) {
        up[t] = keys[t];
      }
      lanes::sort_by(&mut keys, 512, greater);
      for t in 0..512 across lanes(256) {
        down[t] = keys[t];
      }
      for t in 0..512 across lanes(256) {
        keys[t] = ((t * 7919) % 1000) as i64;
      }
      lanes::sort_by(&mut keys, 100, by_last_digit);
      for t in 0..512 across lanes(256) {
        by_digit[t] = keys[t];
      }
      for t in 0..512 across lanes(256) {
        keys[t] = (((t * 7919) % 1000) as i64 - 499) * 1000;
      }
      lanes::sort_descending(&mut keys, 512);
      for t in 0..512 across lanes(256) {
        old_down[t] = keys[t];
      }
    }
  }
  let mut rows = transfer(Tensor<i64, [128]>::fill(0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut part = unsafe { Tensor<i64, [2, 64], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for t in 0..64 across lanes(32) {
          part[w][t] = ((((w * 64 + t) * 7919) % 1000) as i64 - 499) * 1000;
        }
        lanes::sort_by(&mut part[w], 20, greater);
        for t in 0..64 across lanes(32) {
          rows[w * 64 + t] = part[w][t];
        }
      }
    }
  }
  let u = transfer(up, Memory::CPU_DRAM);
  let d = transfer(down, Memory::CPU_DRAM);
  let g = transfer(by_digit, Memory::CPU_DRAM);
  let o = transfer(old_down, Memory::CPU_DRAM);
  let r = transfer(rows, Memory::CPU_DRAM);
  let mut tail = true;
  for i in 500..512 {
    tail = tail && u[i] == key(i);
  }
  println!("up in order {} same keys {} tail kept {} first {} last {}", in_order(&u, 0, 500, 0), same_keys(&u, 0, 0, 512, false), tail, u[0], u[499]);
  println!("down in order {} same keys {} first {} last {}", in_order(&d, 0, 512, 1), same_keys(&d, 0, 0, 512, false), d[0], d[511]);
  let mut digits_tail = true;
  for i in 100..512 {
    digits_tail = digits_tail && g[i] == digits_key(i);
  }
  println!("digits in order {} same keys {} tail kept {} first digit {} last digit {}", in_order(&g, 0, 100, 2), same_keys(&g, 0, 0, 100, true), digits_tail, g[0] % 10, g[99] % 10);
  for w in 0..2 {
    let mut kept = true;
    for i in 20..64 {
      kept = kept && r[w * 64 + i] == key(w * 64 + i);
    }
    println!("row {} in order {} same keys {} tail kept {}", w, in_order(&r, w * 64, 20, 1), same_keys(&r, w * 64, w * 64, 64, false), kept);
  }
  let mut same = true;
  for i in 0..512 {
    same = same && o[i] == d[i];
  }
  println!("sort_descending gives the same keys {}", same);
  return 0;
}
