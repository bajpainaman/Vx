//===----------------------------------------------------------------------===//
// The prover does not accept a wrong value of an integer `/`:
//
// - `rounds_down`: -7 / 2 is -3, not -4, because division rounds toward zero;
// - `signed_as_unsigned`: -8i8 / 2 is -4, not the 124 that an unsigned division of the bits gives;
// - `by_zero`: a division by zero stops the program, so the prover gives it no value;
// - `minimum_by_minus_one`: -128i8 / -1 stops the program, so it has no value either.
//
// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn rounds_down(x : i32) -> i32
requires x == -7
ensures return == -4 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'rounds_down' cannot prove postcondition
  return x / 2;
}

fn signed_as_unsigned(x : i8) -> i8
requires x == -8
ensures return == 124 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'signed_as_unsigned' cannot prove postcondition
  return x / 2i8;
}

fn by_zero(x : u32, d : u32) -> u32
requires d == 0
ensures return == 0 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'by_zero' cannot prove postcondition
  return x / d;
}

fn minimum_by_minus_one(x : i8, d : i8) -> i8
requires x == -128 && d == -1
ensures return == -128 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'minimum_by_minus_one' cannot prove postcondition
  return x / d;
}

fn main() -> i32 {
  return 0;
}
