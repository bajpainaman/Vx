// `pick` reads `t[i]` from a tensor of 4 numbers, and the caller picks `i`. Anyone can call a
// Solana program, so `--emit-sbf` checks the index unless `-fno-bounds-checks` says no.
//
// A Solana program has no `malloc` yet, so this program cannot run on a validator. The test
// reads only the LLVM IR, and it needs no Solana tool.
//
// RUN: vxc %s --emit-sbf -o %t.ll
// RUN: FileCheck %s --input-file=%t.ll
// RUN: vxc %s --emit-sbf -fno-bounds-checks -o %t.off.ll
// RUN: FileCheck %s --check-prefix=OFF --input-file=%t.off.ll --implicit-check-not='index out of bounds'

// With the check, the LLVM IR has the message that a failed check writes to the log.
// CHECK: index out of bounds: an index is outside the shape of the tensor

// With `-fno-bounds-checks`, the function is there and the message is not.
// OFF: define internal i64 @pick(i64 %0)
pub fn pick(i : i64) -> i64 {
  let t : Tensor<i64, [4]> = [7i64, 8i64, 9i64, 10i64];
  return t[i];
}
